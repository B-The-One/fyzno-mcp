{
  "name": "@fyzno/mcp",
  "version": "2.0.0",
  "description": "Read-only MCP server for fyzno.com. Three free reports on any domain: mail security (SPF, DKIM, DMARC, MTA-STS, live STARTTLS), website security (headers, CSP, TLS, cookies) and DNS hygiene (name servers, CAA, SOA). Zero dependencies.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "ai-tools",
    "llm-tools",
    "security",
    "security-headers",
    "csp",
    "content-security-policy",
    "hsts",
    "tls",
    "ssl",
    "certificate",
    "https",
    "dns",
    "caa",
    "dnssec",
    "nameserver",
    "email",
    "email-security",
    "deliverability",
    "spf",
    "dkim",
    "dmarc",
    "mta-sts",
    "smtp",
    "starttls",
    "website-security",
    "security-scanner",
    "domain-check"
  ],
  "homepage": "https://fyzno.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-The-One/fyzno-mcp.git"
  },
  "bugs": {
    "url": "https://fyzno.com/brief",
    "email": "info@fyzno.com"
  },
  "author": {
    "name": "Fyzno",
    "url": "https://fyzno.com"
  },
  "license": "MIT",
  "type": "module",
  "types": "./server.d.mts",
  "exports": {
    ".": {
      "types": "./server.d.mts",
      "default": "./server.mjs"
    },
    "./server.mjs": {
      "types": "./server.d.mts",
      "default": "./server.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fyzno-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "server.d.mts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node test/conformance.mjs",
    "prepublishOnly": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
